{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/mock-broker/v1/events",
    "bodyPatterns": [
      {
        "matches": "(?s).*\"eventId\"\\s*:\\s*\"fault-503\".*"
      }
    ]
  },
  "response": {
    "status": 503,
    "jsonBody": {
      "error": "injected_failure",
      "message": "Configured 503 response for event-sink."
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
