{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathPattern": "^/v1/products/style-9999/sizes/(?:size-34|size-36|size-38|size-40|size-42)$",
    "queryParameters": {
      "countryCode": {
        "equalTo": "PT"
      }
    }
  },
  "response": {
    "status": 200,
    "bodyFileName": "product-context-template.json",
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": [
      "response-template"
    ],
    "transformerParameters": {
      "productStatus": "INACTIVE",
      "countryEnabled": true
    }
  }
}
