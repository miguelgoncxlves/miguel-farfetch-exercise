{
  "info": {
    "_postman_id": "492dfcd1-fabf-4f70-a33a-d73ec2ea4fb8",
    "name": "Size-Level Availability Exercise",
    "description": "Collection for processing inventory events, testing stock-version ordering, and manually calling downstream WireMock endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Process inventory event (local app)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"SellerInventoryChanged\",\n  \"schemaVersion\": 1,\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"sellerId\": \"{{sellerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"sizeId\": \"{{sizeId}}\",\n  \"countryCode\": \"{{countryCode}}\",\n  \"availableQuantity\": {{availableQuantity}},\n  \"sourceVersion\": {{sourceVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{appBaseUrl}}/_dev/messages",
          "host": [
            "{{appBaseUrl}}"
          ],
          "path": [
            "_dev",
            "messages"
          ]
        },
        "description": "First request in the version-ordering sequence. Clear the local H2 state before a fresh sequence; this version should be processed."
      },
      "response": []
    },
    {
      "name": "2. Replay same version (expect duplicate skip)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{replayEventId}}\",\n  \"eventType\": \"SellerInventoryChanged\",\n  \"schemaVersion\": 1,\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"sellerId\": \"{{sellerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"sizeId\": \"{{sizeId}}\",\n  \"countryCode\": \"{{countryCode}}\",\n  \"availableQuantity\": {{availableQuantity}},\n  \"sourceVersion\": {{sourceVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{appBaseUrl}}/_dev/messages",
          "host": [
            "{{appBaseUrl}}"
          ],
          "path": [
            "_dev",
            "messages"
          ]
        },
        "description": "Send after request 1. Uses the same stock key and version but a different eventId; expect skipped/duplicate_version and no new WireMock requests."
      },
      "response": []
    },
    {
      "name": "3. Submit older version (expect stale skip)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{staleEventId}}\",\n  \"eventType\": \"SellerInventoryChanged\",\n  \"schemaVersion\": 1,\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"sellerId\": \"{{sellerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"sizeId\": \"{{sizeId}}\",\n  \"countryCode\": \"{{countryCode}}\",\n  \"availableQuantity\": {{availableQuantity}},\n  \"sourceVersion\": {{staleSourceVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{appBaseUrl}}/_dev/messages",
          "host": [
            "{{appBaseUrl}}"
          ],
          "path": [
            "_dev",
            "messages"
          ]
        },
        "description": "Send after request 1. Uses the same stock key with an older sourceVersion; expect skipped/stale_version and no new WireMock requests."
      },
      "response": []
    },
    {
      "name": "4. Submit newer version (expect processing)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{newerEventId}}\",\n  \"eventType\": \"SellerInventoryChanged\",\n  \"schemaVersion\": 1,\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"sellerId\": \"{{sellerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"sizeId\": \"{{sizeId}}\",\n  \"countryCode\": \"{{countryCode}}\",\n  \"availableQuantity\": {{availableQuantity}},\n  \"sourceVersion\": {{newerSourceVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{appBaseUrl}}/_dev/messages",
          "host": [
            "{{appBaseUrl}}"
          ],
          "path": [
            "_dev",
            "messages"
          ]
        },
        "description": "Send after requests 1–3. This higher version should be processed and create three new downstream WireMock requests."
      },
      "response": []
    },
    {
      "name": "5. Lower version on another seller (expect processing)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{independentEventId}}\",\n  \"eventType\": \"SellerInventoryChanged\",\n  \"schemaVersion\": 1,\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"sellerId\": \"{{independentSellerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"sizeId\": \"{{sizeId}}\",\n  \"countryCode\": \"{{countryCode}}\",\n  \"availableQuantity\": {{availableQuantity}},\n  \"sourceVersion\": {{staleSourceVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{appBaseUrl}}/_dev/messages",
          "host": [
            "{{appBaseUrl}}"
          ],
          "path": [
            "_dev",
            "messages"
          ]
        },
        "description": "Send after request 1. A distinct seller has an independent version stream, so the lower version should be processed."
      },
      "response": []
    },
    {
      "name": "Validation and retry edge cases",
      "description": "Send these requests individually. Validation and context rejection requests should not write availability or publish output. Availability 429/503 cases leave durable work pending; with recovery enabled, the worker can retry in later five-second cycles. Set AVAILABILITY_OUTBOX_RECOVERY_ENABLED=false while starting the app if you want to inspect only the initial three attempts.",
