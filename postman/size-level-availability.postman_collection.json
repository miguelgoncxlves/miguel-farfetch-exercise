{
  "info": {
    "_postman_id": "492dfcd1-fabf-4f70-a33a-d73ec2ea4fb8",
    "name": "Size-Level Availability Exercise",
    "description": "Collection for processing one inventory event and manually testing its downstream WireMock endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Process inventory event (local app)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventType\": \"SellerInventoryChanged\",\n  \"schemaVersion\": 1,\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"sellerId\": \"{{sellerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"sizeId\": \"{{sizeId}}\",\n  \"countryCode\": \"{{countryCode}}\",\n  \"availableQuantity\": {{availableQuantity}},\n  \"sourceVersion\": {{sourceVersion}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{appBaseUrl}}/_dev/messages",
          "host": [
            "{{appBaseUrl}}"
          ],
          "path": [
            "_dev",
            "messages"
          ]
        },
        "description": "Runs the complete single-event flow. The app performs the Product Context lookup, availability update, and output-event publish against WireMock."
      },
      "response": []
    },
    {
      "name": "2. Look up product context (WireMock)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{wiremockBaseUrl}}/v1/products/{{productId}}/sizes/{{sizeId}}?countryCode={{countryCode}}",
          "host": [
            "{{wiremockBaseUrl}}"
          ],
          "path": [
            "v1",
            "products",
            "{{productId}}",
            "sizes",
            "{{sizeId}}"
          ],
          "query": [
            {
              "key": "countryCode",
              "value": "{{countryCode}}"
            }
          ]
        },
        "description": "Optional direct lookup for inspecting the mock response. Not required when running request 1."
      },
      "response": []
    },
    {
      "name": "3. Write availability (WireMock)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"availableQuantity\": {{availableQuantity}},\n  \"sourceVersion\": {{sourceVersion}},\n  \"productContext\": {\n    \"productName\": \"{{productName}}\",\n    \"brand\": {\n      \"id\": \"{{brandId}}\",\n      \"name\": \"{{brandName}}\"\n    },\n    \"sizeLabel\": \"{{sizeLabel}}\",\n    \"sizeSystem\": \"{{sizeSystem}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{wiremockBaseUrl}}/v1/availability/{{sellerId}}/{{productId}}/{{sizeId}}?countryCode={{countryCode}}",
          "host": [
            "{{wiremockBaseUrl}}"
          ],
          "path": [
            "v1",
            "availability",
            "{{sellerId}}",
            "{{productId}}",
            "{{sizeId}}"
          ],
          "query": [
            {
              "key": "countryCode",
              "value": "{{countryCode}}"
            }
          ]
        },
        "description": "Optional direct call to the mock availability API. Request 1 makes this call automatically when the event is eligible."
      },
      "response": []
    },
    {
      "name": "4. Publish output event (WireMock)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{outputEventId}}\",\n  \"eventType\": \"SizeAvailabilityUpdated\",\n  \"schemaVersion\": 1,\n  \"occurredAt\": \"{{outputOccurredAt}}\",\n  \"sellerId\": \"{{sellerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"sizeId\": \"{{sizeId}}\",\n  \"countryCode\": \"{{countryCode}}\",\n  \"availableQuantity\": {{availableQuantity}},\n  \"sourceVersion\": {{sourceVersion}},\n  \"productContext\": {\n    \"productName\": \"{{productName}}\",\n    \"brand\": {\n      \"id\": \"{{brandId}}\",\n      \"name\": \"{{brandName}}\"\n    },\n    \"sizeLabel\": \"{{sizeLabel}}\",\n    \"sizeSystem\": \"{{sizeSystem}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{wiremockBaseUrl}}/mock-broker/v1/events",
          "host": [
            "{{wiremockBaseUrl}}"
          ],
          "path": [
            "mock-broker",
            "v1",
            "events"
          ]
        },
        "description": "Optional direct call to the recording output sink. Request 1 publishes its generated output event automatically."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "appBaseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "wiremockBaseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
